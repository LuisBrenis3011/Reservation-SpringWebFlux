{
  "realm": "eats-hub-local",
  "enabled": true,
  "displayName": "Eats Hub - Desarrollo local",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 900,
  "oauth2DeviceCodeLifespan": 600,
  "oauth2DevicePollingInterval": 5,
  "defaultSignatureAlgorithm": "RS256",
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Cliente de reservas propias de Eats Hub"
      },
      {
        "name": "RESTAURANT_MANAGER",
        "description": "Gestiona los restaurantes asignados"
      }
    ]
  },
  "groups": [
    {
      "name": "11111111-1111-4111-8111-111111111111"
    },
    {
      "name": "22222222-2222-4222-8222-222222222222"
    }
  ],
  "clients": [
    {
      "clientId": "eats-hub-cli",
      "name": "CLI local de validacion",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true",
        "access.token.signed.response.alg": "RS256"
      },
      "protocolMappers": [
        {
          "name": "roles-top-level",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "usermodel.realmRoleMapping.rolePrefix": "",
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "restaurant-ids",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "false",
            "claim.name": "restaurant_ids",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "catalog-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "eats-hub-catalog",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "encargado-a",
      "enabled": true,
      "emailVerified": true,
      "email": "encargado-a@example.test",
      "firstName": "Demo",
      "lastName": "A",
      "requiredActions": [],
      "realmRoles": [
        "RESTAURANT_MANAGER"
      ],
      "groups": [
        "/11111111-1111-4111-8111-111111111111"
      ],
      "credentials": []
    },
    {
      "username": "encargado-b",
      "enabled": true,
      "emailVerified": true,
      "email": "encargado-b@example.test",
      "firstName": "Demo",
      "lastName": "B",
      "requiredActions": [],
      "realmRoles": [
        "RESTAURANT_MANAGER"
      ],
      "groups": [
        "/22222222-2222-4222-8222-222222222222"
      ],
      "credentials": []
    },
    {
      "username": "sin-rol",
      "enabled": true,
      "emailVerified": true,
      "email": "sin-rol@example.test",
      "firstName": "Demo",
      "lastName": "SinRol",
      "requiredActions": [],
      "realmRoles": [],
      "groups": [
        "/11111111-1111-4111-8111-111111111111"
      ],
      "credentials": []
    }
  ]
}
