# Local development only. Copy to .env and replace the example passwords.
# Use plain KEY=value entries without quotes or shell expressions so both
# Spring's properties loader and Docker Compose read the same values.
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=master
MONGODB_PASSWORD=replace-with-local-mongo-password
MONGODB_DATABASE=catalog
MONGODB_AUTH_DATABASE=admin

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-local-redis-password
REDIS_DATABASE=0
REDIS_UI_USERNAME=admin
REDIS_UI_PASSWORD=replace-with-local-ui-password

# PostgreSQL is used by the separate customer-manager service.
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_DB=customers

# Preparación de disponibilidad; mantener desactivado hasta completar la fase 2.
AVAILABILITY_ENABLED=false
AVAILABILITY_ISSUER_URI=
AVAILABILITY_JWK_SET_URI=
AVAILABILITY_AUDIENCE=eats-hub-catalog
# Compose separado: ruta absoluta a un archivo local base64, nunca versionado.
# MONGODB_REPLICA_KEYFILE=D:/proyectosIntellij/SpringWebFlux/secrets/mongo-keyfile
# URI futura (T009): usuario/contraseña deben codificarse para URI.
# MONGODB_URI=mongodb://USER:PASSWORD@localhost:27018/catalog?authSource=admin&replicaSet=rs0
